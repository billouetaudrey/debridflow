{
  "manifest_version": 3,
  "name": "DebridFlow - 1-Click & Context Downloader",
  "version": "1.0.0",
  "description": "Envoyez des liens magnets, torrents et DDL directement vers votre serveur DebridFlow d'un simple clic-droit.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "DebridFlow"
  }
}